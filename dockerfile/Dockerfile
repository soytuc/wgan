# Filname: mwgangp2
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04
ENV TZ=America/Los_Angeles
SHELL ["/bin/bash", "-c"]
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN apt update && DEBIAN_FRONTEND=noninteractive apt install -y git cmake sudo python3-pip unzip wget curl
RUN sudo sh -c 'echo "deb http://packages.ros.org/ros/ubuntu focal main" > /etc/apt/sources.list.d/ros-latest.list';curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | sudo apt-key add -;apt update && DEBIAN_FRONTEND=noninteractive apt install -y ros-noetic-desktop-full python3-rosdep python3-rosinstall python3-rosinstall-generator python3-wstool build-essential ros-noetic-catkin python3-catkin-lint python3-pip python3-catkin-tools; pip3 install osrf-pycommon
RUN cd;mkdir torchModel;cd torchModel/;wget https://download.pytorch.org/libtorch/cu111/libtorch-cxx11-abi-shared-with-deps-1.10.1%2Bcu111.zip;unzip libtorch-cxx11-abi-shared-with-deps-1.10.1+cu111.zip;rm libtorch-cxx11-abi-shared-with-deps-1.10.1+cu111.zip;git clone -b baxterWithoutTorch https://joro3001@bitbucket.org/joro3001/baxter_planning_moveit.git; mv baxter_planning_moveit multiwgangp;ln -s /usr/bin/python3 /usr/bin/python 
RUN cd /root/;git clone https://joro3001@bitbucket.org/joro3001/baxter_noetic.git;mv baxter_noetic baxterws;
RUN cd /root/;git clone -b pathcppimplementation https://joro3001@bitbucket.org/joro3001/moveit_baxter_noetic_realsense_ompl.git;mv moveit_baxter_noetic_realsense_ompl ws_moveit2/;
RUN cd /root;git clone -b master https://joro3001@bitbucket.org/joro3001/imagewgangpplanning.git;mv /root/imagewgangpplanning /root/extrafiles;cd /root/extrafiles;git switch master;cat segment* > generatorPath.pt;cat generatorBaxter.pt* >generatorBaxter.pt;cat generatorPath.pt* > generatorPath.pt;cat generatorPath.pt.subsampled* > generatorPathl.pt.subsampled;cat datasetBaxter.hdf5* > datasetBaxter.hdf5;cp spawn_models.sh /root/;cp real.py /root/;cp /root/extrafiles/runservices.sh /root/;chmod 755 /root/runservices.sh 
RUN echo "export PATH=\$PATH:/root/torchModel/multiwgangp/trainedSamplerModel/build/lib/cmake:/root/torchModel/multiwgangp/cmakeForwardKinematic2d/build/lib/cmake:/root/torchModel/libtorch/share/cmake:/opt/nvim-linux64/bin" >> /root/.bashrc
RUN echo "export LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/root/torchModel/multiwgangp/trainedSamplerModel/install/lib/:/root/torchModel/multiwgangp/cmakeForwardKinematic2d/install/lib/:/root/torchModel/libtorch/lib/" >> /root/.bashrc
RUN echo "alias worksp='source /root/baxterws/devel/setup.bash --extend;source /root/ws_moveit2/devel/setup.bash --extend';" >> /root/.bashrc;echo "alias activate='worksp; rosrun baxter_tools enable_robot.py -e;rosrun baxter_interface joint_trajectory_action_server.py;'" >> /root/.bashrc;echo "alias mvit='worksp;roslaunch baxter_moveit_config baxter_grippers.launch right_electric_gripper:=true left_electric_gripper:=true'" >> /root/.bashrc;echo "alias gaz='worksp;roslaunch multi_robot baxter_realsense_empty_world.launch'" >> /root/.bashrc;echo "alias loadlibs='worksp;export LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/root/torchModel/multiwgangp/trainedSamplerModel/install/lib/:/root/torchModel/multiwgangp/cmakeForwardKinematic2d/install/lib/:/root/torchModel/libtorch/lib/'" >> /root/.bashrc;echo "alias planning='cd /root/ws_moveit2/src/planning;env LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/root/torchModel/multiwgangp/trainedSamplerModel/install/lib/:/root/torchModel/multiwgangp/cmakeForwardKinematic2d/install/lib/ rosrun planning baxter_test /joint_states:=/robot/joint_states'" >> /root/.bashrc
